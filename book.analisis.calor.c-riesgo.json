.set_xticks([0.5, 2.5]); ins.set_xticklabels([\"fresco\", \"cálido\"], fontsize=6)\nins.set_yticks([0.5, 2.5]); ins.set_yticklabels([\"baja\", \"alta\"], fontsize=6)\nins.set_xlabel(\"calor →\", fontsize=6); ins.set_ylabel(\"vulnerab. →\", fontsize=6)\nins.grid(False)\nalto = con[(t_cl == 2) & (v_cl == 2)]\npersonas_alto = f\"{alto['poblacion'].sum():,.0f}\".replace(\",\", \".\")\ndisplay(Markdown(f\"Celdas con **calor alto y vulnerabilidad alta**: {len(alto)}, con {personas_alto} personas estimadas \"\n                 f\"({100 * alto['poblacion'].sum() / con['poblacion'].sum():.0f} % de la población de la malla).\"))","key":"p2Jlftowsr"},{"type":"outputs","id":"KRK_bBafPiTqpfAqve7O8","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/html":{"content":"<p>Celdas con <strong>calor alto y vulnerabilidad alta</strong>: 114, con 40.666 personas estimadas (87 % de la población de la malla).</p>","content_type":"text/html"}}},"children":[],"key":"fTe5AsMQNc"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"93d5144ee966975b17de0782f995362c","path":"/leticia/build/93d5144ee966975b17de0782f995362c.png"},"text/plain":{"content":"<Figure size 640x700 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"cRbmZFjAsB"}],"key":"GuWMzbiP1K"}],"identifier":"1fad5e77","html_id":"1fad5e77","key":"zF2G987Cai"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3. Clases de riesgo relativo","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"pXAHkSLYaR"}],"identifier":"id-3-clases-de-riesgo-relativo","label":"3. Clases de riesgo relativo","html_id":"id-3-clases-de-riesgo-relativo","implicit":true,"key":"N5hkp85a6R"}],"identifier":"4f37737b","html_id":"4f37737b","key":"VEytxpmtmA"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-01T01:04:13.140960Z","iopub.status.busy":"2026-11-01T01:04:13.140686Z","iopub.status.idle":"2026-11-01T01:04:13.173768Z","shell.execute_reply":"2026-11-01T01:04:13.172436Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"malla.loc[con.index, \"vulnerabilidad\"] = con[\"vulnerabilidad\"]\nmalla[\"riesgo_calor\"] = riesgo.matriz_riesgo(riesgo.clasificar(riesgo.normalizar(malla[\"lst_c\"])),\n                                            riesgo.clasificar(malla[\"vulnerabilidad\"]))\ndisplay(malla[malla.n_edif > 0].groupby(\"riesgo_calor\", observed=False)[[\"n_edif\", \"poblacion\"]].sum().round(0))\nmalla[[\"lst_c\", \"ndvi\", \"riesgo_calor\"]].to_csv(fuentes.ruta(\"riesgo_calor_celdas.csv\"))","key":"COUw6y9PeV"},{"type":"outputs","id":"JimWjCbqpDNtAyJ2ho4BR","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/html":{"content":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>n_edif</th>\n      <th>poblacion</th>\n    </tr>\n    <tr>\n      <th>riesgo_calor</th>\n      <th></th>\n      <th></th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>Muy baja</th>\n      <td>154</td>\n      <td>226.00</td>\n    </tr>\n    <tr>\n      <th>Baja</th>\n      <td>507</td>\n      <td>922.00</td>\n    </tr>\n    <tr>\n      <th>Media</th>\n      <td>768</td>\n      <td>2,170.00</td>\n    </tr>\n    <tr>\n      <th>Alta</th>\n      <td>1809</td>\n      <td>7,482.00</td>\n    </tr>\n    <tr>\n      <th>Muy alta</th>\n      <td>3570</td>\n      <td>35,706.00</td>\n    </tr>\n  </tbody>\n</table>\n</div