posicion.malla_exposicion()\nlst = espacial.temperatura_superficie(2024, pc[\"meses_landsat\"], nubes_max=pc[\"nubes_max\"])\nmalla[\"lst_c\"] = espacial.estadistica_zonal(lst[\"lst\"].rio.write_crs(4326), malla)\nmalla[\"ndvi\"] = espacial.estadistica_zonal(lst[\"ndvi\"].rio.write_crs(4326), malla)\ncon = malla[(malla.n_edif > 0) & malla.lst_c.notna()].copy()\ncon[\"lst_anomalia\"] = con[\"lst_c\"] - con[\"lst_c\"].median()","key":"P4af5neSDi"},{"type":"outputs","id":"MXrZhgRVtgVUpj2FQdLIR","children":[],"key":"evNrrlN9Yh"}],"identifier":"e684d312","html_id":"e684d312","key":"js5V8cQUMA"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"1. Temperatura de superficie por celda","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"b9Ju6RMR9r"}],"identifier":"id-1-temperatura-de-superficie-por-celda","label":"1. Temperatura de superficie por celda","html_id":"id-1-temperatura-de-superficie-por-celda","implicit":true,"key":"O3HgLFlXGh"}],"identifier":"eaf124b8","html_id":"eaf124b8","key":"EjEQjcguMq"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-01T01:04:11.078469Z","iopub.status.busy":"2026-11-01T01:04:11.077934Z","iopub.status.idle":"2026-11-01T01:04:12.392206Z","shell.execute_reply":"2026-11-01T01:04:12.391020Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"fig, ax = plt.subplots(figsize=(6.4, 7))\nviz.mapa_celdas(con, \"lst_anomalia\", ax=ax, cmap=\"RdBu_r\", etiqueta=\"°C respecto a la mediana urbana\", vmin=-4, vmax=4,\n                titulo=\"Anomalía de temperatura de superficie\")\ntop = con.nlargest(10, \"lst_anomalia\")[[\"lst_c\", \"lst_anomalia\", \"ndvi\", \"n_edif\", \"poblacion\"]]\ndisplay(Markdown(f\"Entre la celda más caliente y la mediana urbana hay **{con['lst_anomalia'].max():.1f} °C**; \"\n                 f\"el 1