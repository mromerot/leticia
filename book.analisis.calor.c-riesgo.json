.set_xticks([0.5, 2.5]); ins.set_xticklabels([\"fresco\", \"cálido\"], fontsize=6)\nins.set_yticks([0.5, 2.5]); ins.set_yticklabels([\"baja\", \"alta\"], fontsize=6)\nins.set_xlabel(\"calor →\", fontsize=6); ins.set_ylabel(\"vulnerab. →\", fontsize=6)\nins.grid(False)\nalto = con[(t_cl == 2) & (v_cl == 2)]\ndisplay(Markdown(f\"Celdas con **calor alto y vulnerabilidad alta**: {len(alto)}, con {alto['poblacion'].sum():,.0f} personas estimadas \"\n                 f\"({100 * alto['poblacion'].sum() / con['poblacion'].sum():.0f} % de la población de la malla).\".replace(\",\", \".\")))","key":"GOm0UGo0oc"},{"type":"outputs","id":"U_Xh8OHNBdmLQtoUFuInd","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/html":{"content":"<p>Celdas con <strong>calor alto y vulnerabilidad alta</strong>: 114. con 40.666 personas estimadas (87 % de la población de la malla).</p>","content_type":"text/html"}}},"children":[],"key":"uwpWadTxxX"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"93d5144ee966975b17de0782f995362c","path":"/leticia/build/93d5144ee966975b17de0782f995362c.png"},"text/plain":{"content":"<Figure size 640x700 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"IPRHvTG4E5"}],"key":"WhqVEigQUh"}],"identifier":"b9d75dbb","html_id":"b9d75dbb","key":"lSvCNds0GA"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3. Clases de riesgo relativo","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"UTHMyaJSOX"}],"identifier":"id-3-clases-de-riesgo-relativo","label":"3. Clases de riesgo relativo","html_id":"id-3-clases-de-riesgo-relativo","implicit":true,"key":"uIXUVmTSdp"}],"identifier":"21d7e3d1","html_id":"21d7e3d1","key":"nbNqBcHeU4"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-10-28T20:33:37.935777Z","iopub.status.busy":"2026-10-28T20:33:37.935556Z","iopub.status.idle":"2026-10-28T20:33:37.964123Z","shell.execute_reply":"2026-10-28T20:33:37.962777Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"malla.loc[con.index, \"vulnerabilidad\"] = con[\"vulnerabilidad\"]\nmalla[\"riesgo_calor\"] = riesgo.matriz_riesgo(riesgo.clasificar(riesgo.normalizar(malla[\"lst_c\"])),\n                                            riesgo.clasificar(malla[\"vulnerabilidad\"]))\ndisplay(malla[malla.n_edif > 0].groupby(\"riesgo_calor\", observed=False)[[\"n_edif\", \"poblacion\"]].sum().round(0))\nmalla[[\"lst_c\", \"ndvi\", \"riesgo_calor\"]].to_csv(fuentes.ruta(\"riesgo_calor_celdas.csv\"))","key":"J41uRkk9yA"},{"type":"outputs","id":"KRjUrdPvuTTCyJZAMsQ1F","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/html":{"content":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>n_edif</th>\n      <th>poblacion</th>\n    </tr>\n    <tr>\n      <th>riesgo_calor</th>\n      <th></th>\n      <th></th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>Muy baja</th>\n      <td>154</td>\n      <td>226.00</td>\n    </tr>\n    <tr>\n      <th>Baja</th>\n      <td>507</td>\n      <td>922.00</td>\n    </tr>\n    <tr>\n      <th>Media</th>\n      <td>768</td>\n      <td>2,170.00</td>\n    </tr>\n    <tr>\n      <th>Alta</th>\n      <td>1809</td>\n      <td>7,482.00</td>\n    </tr>\n    <tr>\n      <th>Muy alta</th>\n      <td>3570</td>\n      <td>35,706.00</td>\n    </tr>\n  </tbody>\n</table>\n</div>","content_type":"text/html"},"text/p