ot/leticia/blob/main/book/03_analisis/37_dengue/b_amenaza.ipynb","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"image","url":"/leticia/build/7e2db436150c38a00650f96925aa5581.svg","alt":"Abrir en Colab","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"kpJ2Ob3qeQ","urlSource":"https://colab.research.google.com/assets/colab-badge.svg"}],"urlSource":"https://colab.research.google.com/github/mromerot/leticia/blob/main/book/03_analisis/37_dengue/b_amenaza.ipynb","key":"BRFr8wB4Ou"}],"key":"AYNvaPWddp"}],"key":"nNAHhZRBJx"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-10-28T23:41:35.258846Z","iopub.status.busy":"2026-10-28T23:41:35.258524Z","iopub.status.idle":"2026-10-28T23:41:35.847140Z","shell.execute_reply":"2026-10-28T23:41:35.845521Z"},"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"# Preparación del entorno. En Colab instala el paquete del proyecto desde GitHub (1–2 minutos);\n# en una copia local usa el paquete ya instalado con `pip install -e .`.\nimport sys, subprocess\nif \"google.colab\" in sys.modules:\n    subprocess.run([sys.executable, \"-m\", \"pip\", \"install\", \"-q\", \"leticia @ git+https://github.com/mromerot/leticia\"], check=True)\nfrom leticia.libro import preparar, intentar\npreparar()","visibility":"show","key":"Yxvv210F6o"},{"type":"outputs","id":"MLHps4oTKoNS6nWMLNFJa","children":[],"visibility":"show","key":"z6uJGAocxh"}],"identifier":"a4ceb376","html_id":"a4ceb376","visibility":"remove","key":"EGDWzY4PNn"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"El dengue es una amenaza biológica, pero su transmisión depende del clima: la temperatura acelera el desarrollo del\nmosquito ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"WjMQbPNsUP"},{"type":"emphasis","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Aedes aegypti","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"XuvJ0GZ8rZ"}],"key":"vxjDkvdlES"},{"type":"text","value":" y la replicación del virus, la lluvia y el almacenamiento de agua crean criaderos, y la\nhumedad prolonga la vida del vector. Este cuaderno describe los casos notificados en Leticia y su relación con el\nclima, como paso previo al pronóstico de ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"TI2ZDYalJc"},{"type":"link","url":"/book/analisis/dengue/c-riesgo","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3.7.c","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"DbMctlTf4d"}],"urlSource":"c_riesgo.ipynb","dataUrl":"/book.analisis.dengue.c-riesgo.json","internal":true,"protocol":"file","key":"qND7dVGvF4"},{"type":"text","value":". Los casos vienen del SIVIGILA del Instituto\nNacional de Salud, compilados y estandarizados por OpenDengue ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Z0CgjlmmwP"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"cite","identifier":"clarke2024opendengue","label":"clarke2024opendengue","kind":"parenthetical","position":{"start":{"line":1,"column":517},"end":{"line":1,"column":538}},"children":[{"type":"text","value":"Clarke ","key":"v5xoQFbcyU"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"z9J4BIprMX"}],"key":"bFB1yL4yOX"},{"type":"text","value":", 2024","key":"wKgWEnt5ch"}],"enumerator":"1","key":"EnlHaZpSy8"}],"key":"wv7Y2EoajP"},{"type":"text","value":".","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"TJbZA3T4M5"}],"key":"czDDA8kIEa"}],"identifier":"bfd7d7e1","html_id":"bfd7d7e1","key":"L697D4UPaK"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-10-28T23:41:35.850197Z","iopub.status.busy":"2026-10-28T23:41:35.849765Z","iopub.status.idle":"2026-10-28T23:41:36.670783Z","shell.execute_reply":"2026-10-28T23:41:36.669453Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"import matplotlib.pyplot as plt\nimport numpy as np\nimport pandas as pd\nfrom IPython.display import Markdown, display\n\nfrom leticia import fuentes, salud, viz\nfrom leticia.config import parametros\n\npdg = parametros()[\"dengue\"]\nsemanal = fuentes.dengue_opendengue()\nmensual = salud.casos_mensuales(semanal)","key":"BuFRWq8mZT"},{"type":"outputs","id":"GMvGOfNklViBOTSWW9Jx8","children":[],"key":"NSdm8rBJH1"}],"identifier":"64608e93","html_id":"64608e93","key":"Kx7pjQ5ZuQ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"1. Casos notificados, 2007–2022","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"nPRwZprnM9"}],"identifier":"id-1-casos-notificados-2007-2022","label":"1. Casos notificados, 2007–2022","html_id":"id-1-casos-notificados-2007-2022","implicit":true,"key":"FJy5sTOc2H"}],"identifier":"78a587e9","html_id":"78a587e9","key":"SZuI0TDHu2"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-10-28T23:41:36.675221Z","iopub.status.busy":"2026-10-28T23:41:36.674905Z","iopub.status.idle":"2026-10-28T23:41:37.791238Z","shell.execute_reply":"2026-10-28T23:41:37.789248Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"anual = semanal.groupby(semanal.index.year).sum()\nfig, ax = plt.subplots(1, 2, figsize=(12, 3.6), gridspec_kw={\"width_ratios\": [2.2, 1]})\nax[0].bar(semanal.index, semanal, width=6, color=viz.ROJO)\nax[0].set_ylabel(\"casos por semana\")\nax[0].set_title(\"Dengue notificado en Leticia por semana epidemiológica\")\nax[1].bar(anual.index, anual, color=viz.ROJO)\nax[1].set_title(\"Casos por año\")\nfig.tight_layout()\ndisplay(Markdown(f\"Casos notificados {semanal.index.min():%Y}–{semanal.index.max():%Y}: **{int(semanal.sum()):,}**\".replace(\",\", \".\")\n                 + f\". Años con más casos: \" + \", \".join(f\"{a} ({int(v):,})\".replace(\",\", \".\") for a, v in anual.nlargest(3).items()) + \".\"))","key":"ZA8ILWxclG"},{"type":"outputs","id":"MHkLC3rQHSwhMizeQweiF","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/html":{"content":"<p>Casos notificados 2007–2022: <strong>4.366</strong>. Años con más casos: 2019 (1.716), 2011 (528), 2014 (430).</p>","content_type":"text/html"}}},"children":[],"key":"olmDLmjju0"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"e37fa97349490e55960b39339168e03a","path":"/leticia/build/e37fa97349490e55960b39339168e03a.png"},"text/plain":{"content":"<Figure size 1200x360 with 2 Axes>","content_type":"text/plain"}}},"children":[],"key":"Vl4eAMKdXc"}],"key":"HMARbLn4qk"}],"identifier":"e7e36b58","html_id":"e7e36b58","key":"DKUHG8LCi1"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-10-28T23:41:37.794393Z","iopub.status.busy":"2026-10-28T23:41:37.794123Z","iopub.status.idle":"2026-10-28T23:41:37.818571Z","shell.execute_reply":"2026-10-28T23:41:37.816899Z"},"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"viz.pie(viz.nota_fuente(\"dengue_opendengue\"))","visibility":"remove","key":"pMVAOI0wa7"},{"type":"outputs","id":"y24DPHARaQfir7liKPssP","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/html":{"content":"<p><em>Fuente: OpenDengue (Clarke et al., 2024) con datos del SIVIGILA – Instituto Nacional de Salud — OpenDengue V1.3, extracto espacial (Colombia a nivel municipal, semanal).</em></p>","content_type":"text/html"}}},"children":[],"key":"ID5u8xaWi6"}],"visibility":"show","key":"J9TEMpprZb"}],"identifier":"febcad4f","html_id":"febcad4f","visibility":"show","key":"AmuDqIb0bR"},{"type":"block","kind":"notebook-content","children":[{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Calidad de la serie","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"HWbYKQOFGI"}],"key":"uDmv7ycR2s"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"De 2007 a 2010 la serie registra menos de 25 casos por año, frente a cientos desde 2011. Es más probable un cambio en\nla notificación o en la extracción de los datos que un cambio real en la transmisión, así que los análisis\nestadísticos usan ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"rLtCCYvwKB"},{"type":"strong","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"2011–2022","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"lV7KqLxBxM"}],"key":"IqruBtohHZ"},{"type":"text","value":". OpenDengue solo publica las semanas con casos; las semanas sin registro se cuentan\ncomo cero. Los casos notificados subestiman la transmisión: muchos casos leves no consultan.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"KMqks3UqlF"}],"key":"gqawAhwas6"}],"key":"yJRAA8sNV2"}],"identifier":"d9c71c08","html_id":"d9c71c08","key":"i9kT0Adu9w"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"2. Estacionalidad del dengue y del clima","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"VCZxXuqs8Z"}],"identifier":"id-2-estacionalidad-del-dengue-y-del-clima","label":"2. Estacionalidad del dengue y del clima","html_id":"id-2-estacionalidad-del-dengue-y-del-clima","implicit":true,"key":"DhoqvnSriw"}],"identifier":"b4befa3a","html_id":"b4befa3a","key":"TCy7eDDUL3"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-10-28T23:41:37.821581Z","iopub.status.busy":"2026-10-28T23:41:37.821349Z","iopub.status.idle":"2026-10-28T23:41:38.160518Z","shell.execute_reply":"2026-10-28T23:41:38.159459Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"era = fuentes.clima_diario()\nbase = era.loc[\"1991\":\"2020\"]\ncas = mensual.loc[\"2011\":]\nciclo = pd.DataFrame({\n    \"casos (promedio mensual)\": cas.groupby(cas.index.month).mean(),\n    \"lluvia (mm/mes)\": base[\"precipitation_sum\"].resample(\"MS\").sum().groupby(lambda f: f.month).mean(),\n    \"temperatura media (°C)\": base[\"temperature_2m_mean\"].groupby(base.index.month).mean(),\n})\nfig, ax = plt.subplots(figsize=(9.5, 3.8))\nax.bar(ciclo.index, ciclo[\"casos (promedio mensual)\"], color=viz.ROJO, alpha=0.85, label=\"casos de dengue (2011–2022)\")\nax.set_ylabel(\"casos por mes\")\nax2 = ax.twinx()\nax2.plot(ciclo.index, ciclo[\"lluvia (mm/mes)\"], \"o-\", color=viz.AZUL_RIO, label=\"lluvia 1991–2020\")\nax2.set_ylabel(\"lluvia (mm/mes)\")\nax2.grid(False)\nax.set_xticks(range(1, 13)); ax.set_xticklabels(list(\"EFMAMJJASOND\"))\nax.set_title(\"Ciclo anual del dengue y de la lluvia en Leticia\")\nfig.legend(loc=\"lower center\", ncol=2, bbox_to_anchor=(0.5, 0.0), fontsize=8)\nfig.tight_layout(rect=(0, 0.07, 1, 1))\ndisplay(ciclo.round(1).T)","key":"HnyohTASZy"},{"type":"outputs","id":"WkNpyUX16e47FS1f4vVy2","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/html":{"content":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical