ot/leticia/blob/main/book/03_analisis/37_dengue/b_amenaza.ipynb","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"image","url":"/leticia/build/7e2db436150c38a00650f96925aa5581.svg","alt":"Abrir en Colab","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"yBEliX57do","urlSource":"https://colab.research.google.com/assets/colab-badge.svg"}],"urlSource":"https://colab.research.google.com/github/mromerot/leticia/blob/main/book/03_analisis/37_dengue/b_amenaza.ipynb","key":"HznYicH11j"}],"key":"F5efxYvVXG"}],"key":"xDZbipAOBh"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-10-28T23:41:35.258846Z","iopub.status.busy":"2026-10-28T23:41:35.258524Z","iopub.status.idle":"2026-10-28T23:41:35.847140Z","shell.execute_reply":"2026-10-28T23:41:35.845521Z"},"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"# Preparación del entorno. En Colab instala el paquete del proyecto desde GitHub (1–2 minutos);\n# en una copia local usa el paquete ya instalado con `pip install -e .`.\nimport sys, subprocess\nif \"google.colab\" in sys.modules:\n    subprocess.run([sys.executable, \"-m\", \"pip\", \"install\", \"-q\", \"leticia @ git+https://github.com/mromerot/leticia\"], check=True)\nfrom leticia.libro import preparar, intentar\npreparar()","visibility":"show","key":"rgtwbg7B53"},{"type":"outputs","id":"pI4E2NZe3jJyEot-abv3W","children":[],"visibility":"show","key":"FNXkGlk1v8"}],"identifier":"a4ceb376","html_id":"a4ceb376","visibility":"remove","key":"szxbIcCztx"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"El dengue es una amenaza biológica, pero su transmisión depende del clima: la temperatura acelera el desarrollo del\nmosquito ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"EQd3mmetbO"},{"type":"emphasis","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Aedes aegypti","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"p3we58ShwL"}],"key":"CWUunKAplS"},{"type":"text","value":" y la replicación del virus, la lluvia y el almacenamiento de agua crean criaderos, y la\nhumedad prolonga la vida del vector. Este cuaderno describe los casos notificados en Leticia y su relación con el\nclima, como paso previo al pronóstico de ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"fAQmD1P8LY"},{"type":"link","url":"/book/analisis/dengue/c-riesgo","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3.7.c","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"XP0uCRJECP"}],"urlSource":"c_riesgo.ipynb","dataUrl":"/book.analisis.dengue.c-riesgo.json","internal":true,"protocol":"file","key":"RddHeXHrJF"},{"type":"text","value":". Los casos vienen del SIVIGILA del Instituto\nNacional de Salud, compilados y estandarizados por OpenDengue ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"bx5dJntr5f"},{"type":"citeGroup","kind":"parenthetical","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"cite","identifier":"clarke2024opendengue","label":"clarke2024opendengue","kind":"parenthetical","position":{"start":{"line":1,"column":517},"end":{"line":1,"column":538}},"children":[{"type":"text","value":"Clarke ","key":"tXhilEntSH"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"ajY9OTC668"}],"key":"aiGcZ8xiiT"},{"type":"text","value":", 2024","key":"sM2KHfBbAQ"}],"enumerator":"1","key":"cqVtpuavzU"}],"key":"v6gdKz0zVE"},{"type":"text","value":".","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Fp2vQ1cn9P"}],"key":"mLj7T0oNaA"}],"identifier":"bfd7d7e1","html_id":"bfd7d7e1","key":"uI0hoI743r"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-10-28T23:41:35.850197Z","iopub.status.busy":"2026-10-28T23:41:35.849765Z","iopub.status.idle":"2026-10-28T23:41:36.670783Z","shell.execute_reply":"2026-10-28T23:41:36.669453Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"import matplotlib.pyplot as plt\nimport numpy as np\nimport pandas as pd\nfrom IPython.display import Markdown, display\n\nfrom leticia import fuentes, salud, viz\nfrom leticia.config import parametros\n\npdg = parametros()[\"dengue\"]\nsemanal = fuentes.dengue_opendengue()\nmensual = salud.casos_mensuales(semanal)","key":"t3QXBJCa3O"},{"type":"outputs","id":"L5ULj8H_84ai-GV0GP35y","children":[],"key":"elQR0SHy5a"}],"identifier":"64608e93","html_id":"64608e93","key":"JJWGylRAuC"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"1. Casos notificados, 2007–2022","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"kUPOJMZ1RU"}],"identifier":"id-1-casos-notificados-2007-2022","label":"1. Casos notificados, 2007–2022","html_id":"id-1-casos-notificados-2007-2022","implicit":true,"key":"I7h0ATmeuB"}],"identifier":"78a587e9","html_id":"78a587e9","key":"xCRS5XdxmS"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-10-28T23:41:36.675221Z","iopub.status.busy":"2026-10-28T23:41:36.674905Z","iopub.status.idle":"2026-10-28T23:41:37.791238Z","shell.execute_reply":"2026-10-28T23:41:37.789248Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"anual = semanal.groupby(semanal.index.year).sum()\nfig, ax = plt.subplots(1, 2, figsize=(12, 3.6), gridspec_kw={\"width_ratios\": [2.2, 1]})\nax[0].bar(semanal.index, semanal, width=6, color=viz.ROJO)\nax[0].set_ylabel(\"casos por semana\")\nax[0].set_title(\"Dengue notificado en Leticia por semana epidemiológica\")\nax[1].bar(anual.index, anual, color=viz.ROJO)\nax[1].set_title(\"Casos por año\")\nfig.tight_layout()\ndisplay(Markdown(f\"Casos notificados {semanal.index.min():%Y}–{semanal.index.max():%Y}: **{int(semanal.sum()):,}**\".replace(\",\", \".\")\n                 + f\". Años con más casos: \" + \", \".join(f\"{a} ({int(v):,})\".replace(\",\", \".\") for a, v in anual.nlargest(3).items()) + \".\"))","key":"T4jhRetWJ3"},{"type":"outputs","id":"yP58TY3NEdPyKnoDrAvzA","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/html":{"content":"<p>Casos notificados 2007–2022: <strong>4.366</strong>. Años con más casos: 2019 (1.716), 2011 (528), 2014 (430).</p>","content_type":"text/html"}}},"children":[],"key":"m9MZ5bg0oF"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"e37fa97349490e55960b39339168e03a","path":"/leticia/build/e37fa97349490e55960b39339168e03a.png"},"text/plain":{"content":"<Figure size 1200x360 with 2 Axes>","content_type":"text/plain"}}},"children":[],"key":"pfVgrgG6xd"}],"key":"BheBAZrNG4"}],"identifier":"e7e36b58","html_id":"e7e36b58","key":"lPB7Y0xN0w"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-10-28T23:41:37.794393Z","iopub.status.busy":"2026-10-28T23:41:37.794123Z","iopub.status.idle":"2026-10-28T23:41:37.818571Z","shell.execute_reply":"2026-10-28T23:41:37.816899Z"},"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"viz.pie(viz.nota_fuente(\"dengue_opendengue\"))","visibility":"remove","key":"IMneWxjPVk"},{"type":"outputs","id":"diPDukWJ7UUV4NRjKnJQX","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/html":{"content":"<p><em>Fuente: OpenDengue (Clarke et al., 2024) con datos del SIVIGILA – Instituto Nacional de Salud — OpenDengue V1.3, extracto espacial (Colombia a nivel municipal, semanal).</em></p>","content_type":"text/html"}}},"children":[],"key":"DAVwPdpCw5"}],"visibility":"show","key":"ypTiS74m3m"}],"identifier":"febcad4f","html_id":"febcad4f","visibility":"show","key":"RjmBBudukW"},{"type":"block","kind":"notebook-content","children":[{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Calidad de la serie","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"LNChphxMbx"}],"key":"cwMl6d76oA"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"De 2007 a 2010 la serie registra menos de 25 casos por año, frente a cientos desde 2011. Es más probable un cambio en\nla notificación o en la extracción de los datos que un cambio real en la transmisión, así que los análisis\nestadísticos usan ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"g5M510vXqi"},{"type":"strong","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"2011–2022","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"NJJDg5N7qT"}],"key":"RTNlsqh8Og"},{"type":"text","value":". OpenDengue solo publica las semanas con casos; las semanas sin registro se cuentan\ncomo cero. Los casos notificados subestiman la transmisión: muchos casos leves no consultan.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"NvR9S6UCGA"}],"key":"Sw9Cm12QD0"}],"key":"KJCFn8mjmw"}],"identifier":"d9c71c08","html_id":"d9c71c08","key":"t2WfEfQBzy"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"2. Estacionalidad del dengue y del clima","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"SAiTQ8K8bx"}],"identifier":"id-2-estacionalidad-del-dengue-y-del-clima","label":"2. Estacionalidad del dengue y del clima","html_id":"id-2-estacionalidad-del-dengue-y-del-clima","implicit":true,"key":"AFiHYXK6FF"}],"identifier":"b4befa3a","html_id":"b4befa3a","key":"rAlBhOU6vT"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-10-28T23:41:37.821581Z","iopub.status.busy":"2026-10-28T23:41:37.821349Z","iopub.status.idle":"2026-10-28T23:41:38.160518Z","shell.execute_reply":"2026-10-28T23:41:38.159459Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"era = fuentes.clima_diario()\nbase = era.loc[\"1991\":\"2020\"]\ncas = mensual.loc[\"2011\":]\nciclo = pd.DataFrame({\n    \"casos (promedio mensual)\": cas.groupby(cas.index.month).mean(),\n    \"lluvia (mm/mes)\": base[\"precipitation_sum\"].resample(\"MS\").sum().groupby(lambda f: f.month).mean(),\n    \"temperatura media (°C)\": base[\"temperature_2m_mean\"].groupby(base.index.month).mean(),\n})\nfig, ax = plt.subplots(figsize=(9.5, 3.8))\nax.bar(ciclo.index, ciclo[\"casos (promedio mensual)\"], color=viz.ROJO, alpha=0.85, label=\"casos de dengue (2011–2022)\")\nax.set_ylabel(\"casos por mes\")\nax2 = ax.twinx()\nax2.plot(ciclo.index, ciclo[\"lluvia (mm/mes)\"], \"o-\", color=viz.AZUL_RIO, label=\"lluvia 1991–2020\")\nax2.set_ylabel(\"lluvia (mm/mes)\")\nax2.grid(False)\nax.set_xticks(range(1, 13)); ax.set_xticklabels(list(\"EFMAMJJASOND\"))\nax.set_title(\"Ciclo anual del dengue y de la lluvia en Leticia\")\nfig.legend(loc=\"lower center\", ncol=2, bbox_to_anchor=(0.5, 0.0), fontsize=8)\nfig.tight_layout(rect=(0, 0.07, 1, 1))\ndisplay(ciclo.round(1).T)","key":"QMqybHSUbF"},{"type":"outputs","id":"kJzT0uko-v1hQuijSmK4o","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/html":{"content":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical